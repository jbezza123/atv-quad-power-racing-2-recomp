@echo off
setlocal EnableExtensions
set "ROOT=%~dp0"
set "EXE=%ROOT%my_xbox_game.exe"
set "LOGDIR=%ROOT%logs"
set "LOG=%LOGDIR%\game.log"
if not exist "%EXE%" (
  echo Game executable not found. Run "Install Wizard.bat" first.
  pause
  exit /b 2
)
if not exist "%ROOT%game\default.xbe" (
  echo Game data is missing. Run "Install Wizard.bat" and select your legally obtained ATV Quad Power Racing 2 XISO.
  pause
  exit /b 3
)
if not exist "%LOGDIR%" mkdir "%LOGDIR%"
cd /d "%ROOT%"
set RECOMP_WATCHDOG_SECS=
set RECOMP_VBLANK=1
set RECOMP_PB_EXEC=1
set RECOMP_FB_WINDOW=1
set RECOMP_AC97_READY=1
set RECOMP_USB=1
set RECOMP_KEYBOARD=1
set RECOMP_DISPATCH_GATE=1
set RECOMP_GUEST_CPUS=one
set RECOMP_RASTER_THREADS=4
set RECOMP_AUDIO_BUF_COUNT=6
set RECOMP_D3D_BACKEND=direct
set RECOMP_D3D_MAX_DRAWS=3250
set RECOMP_D3D_BYPASS_COMBINER=0
set RECOMP_D3D_RAW_TEXTURE=0
set RECOMP_D3D_FORCE_NO_DEPTH=0
set RECOMP_D3D_FORCE_NO_CULL=0
set RECOMP_D3D_DEPTH_CLEAR=1
set RECOMP_KEY_TRACE=0
set RECOMP_KERNEL_WAIT_TRACE=0
rem Preserve the tested event/ISR compatibility path; this is not trace output.
set RECOMP_TITLE_KEVENTS=1
set RECOMP_NV2A_SW5_EVENT_TEST=0
set RECOMP_NV2A_SW5_ISR_TEST=1
set RECOMP_PAD_SCRIPT=
set RECOMP_PAD_LIVE=
set RECOMP_D3D_TRACE=
set RECOMP_D3D_BATCH_TRACE=0
set RECOMP_D3D_SUN_TRACE=0
set RECOMP_D3D_SUN_TRACE_ALWAYS=0
set RECOMP_D3D_TEXTURE_DUMP_ADDRS=
set "RECOMP_D3D_TEXTURE_DUMP_PREFIX="
set "RECOMP_D3D_SUN_TEXTURE_DUMP_PREFIX="
set RECOMP_D3D_SHADOW_AUTO_TRACE=0
set RECOMP_D3D_SHADOW_GEOM_TRACE=0
set RECOMP_D3D_SHADOW_ROUTE_TRACE=0
set RECOMP_D3D_SHADOW_VSH_TRACE=0
set RECOMP_D3D_SHADOW_FORCE_COMBINER=0
set RECOMP_D3D_SHADOW_NO_CULL=0
set RECOMP_D3D_SHADOW_OUTSIDE_ZERO=0
set RECOMP_D3D_SHADOW_TILE_TRACE=0
set RECOMP_D3D_SHADOW_CARD_TRACE=0
set "RECOMP_D3D_SHADOW_TEXTURE_DUMP_PREFIX="
set RECOMP_D3D_SHADOW_PER_STAGE_SAMPLER_TEST=0
set RECOMP_D3D_SHADOW_SKIP_MASK=0
set RECOMP_D3D_PANEL_TRACE=0
set "RECOMP_D3D_PANEL_TEXTURE_DUMP_PREFIX="
set "RECOMP_D3D_RECORD_RT_DUMP_PREFIX="
set RECOMP_D3D_PANEL_FRAME_DUMP_PATH=
set RECOMP_D3D_PERF_TRACE=0
set RECOMP_D3D_TRACE_TARGETS=0
set RECOMP_D3D_TRACE_TEXTURE=0
set RECOMP_D3D_TEXTURE_TRACE=0
set RECOMP_D3D_TEXTURE_HASH_TRACE=0
set RECOMP_D3D_COMBINER_RAW_TRACE=0
set RECOMP_TEX_STATE=0
set RECOMP_VSH_TRACE=0
set RECOMP_VSH_DUMP=
set RECOMP_FILE_IO_TRACE=0
set RECOMP_PVIDEO_TRACE=0
"%EXE%" > "%LOG%" 2>&1
set "GAME_EXIT=%ERRORLEVEL%"
echo Game exited with code %GAME_EXIT%. Log: "%LOG%"
pause
exit /b %GAME_EXIT%
